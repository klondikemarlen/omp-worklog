#!/usr/bin/env node
import { execFileSync } from "node:child_process"
import { mkdtempSync, rmSync, writeFileSync } from "node:fs"
import { tmpdir } from "node:os"
import { join } from "node:path"
import { isDeepStrictEqual } from "node:util"

// The CLI resolves settings against cwd; an isolated directory excludes project overrides.
const directory = mkdtempSync(join(tmpdir(), "omp-worklog-release-"))
let phase = "listing installed plugins"
let snapshotPath

function run(description, args) {
  phase = description
  return execFileSync("omp", args, {
    cwd: directory,
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
  })
}

function userSettings() {
  const { settings } = JSON.parse(run("exporting user settings", ["plugin", "config", "list", "omp-worklog", "--json"]))
  if (!settings || typeof settings !== "object" || Array.isArray(settings)) {
    throw new Error("Invalid settings export")
  }

  return settings
}

try {
  const plugins = JSON.parse(run("listing installed plugins", ["plugin", "list", "--json"])).npm ?? []
  const installed = new Set(plugins.map(plugin => plugin.name))
  let settings
  if (installed.has("omp-worklog")) {
    settings = userSettings()
    const backupPath = join(directory, "settings.json")
    phase = "saving the private settings snapshot"
    writeFileSync(backupPath, JSON.stringify(settings), { mode: 0o600, flag: "wx" })
    snapshotPath = backupPath
    console.log(`Saved private Worklog settings backup: ${snapshotPath}`)
    run("uninstalling omp-worklog", ["plugin", "uninstall", "omp-worklog"])
  }

  if (installed.has("harvest-worklog")) {
    run("uninstalling harvest-worklog", ["plugin", "uninstall", "harvest-worklog"])
  }

  run("installing omp-worklog", ["plugin", "install", "--force", "github:klondikemarlen/omp-worklog"])
  if (settings) {
    for (const [key, value] of Object.entries(settings)) {
      const argument = typeof value === "string" ? value : JSON.stringify(value)
      run("restoring user settings", ["plugin", "config", "set", "omp-worklog", key, argument])
    }
    if (!isDeepStrictEqual(userSettings(), settings)) {
      phase = "verifying restored user settings"
      throw new Error("Settings changed")
    }
  }

  console.log("Installed omp-worklog; user settings preserved.")
} catch {
  console.error(`Worklog release failed while ${phase}.`)
  if (snapshotPath) console.error(`Recover saved user settings from ${snapshotPath}.`)
  process.exitCode = 1
} finally {
  if (!snapshotPath) rmSync(directory, { recursive: true, force: true })
}
